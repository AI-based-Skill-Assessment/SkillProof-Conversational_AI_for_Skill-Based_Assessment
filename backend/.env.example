# ─── Application Settings ─────────────────────────────────────────────────────
APP_NAME=SkillProof
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# ─── Database Configuration (PostgreSQL via asyncpg) ──────────────────────────
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# Port 5433 = root docker-compose.yml; use 5432 for a natively installed PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5433/skillproof

# ─── Cache Configuration (Redis) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI Services Configuration ───────────────────────────────────────────────
# Get your free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq model names (change here if Groq deprecates a model)
# GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# Empty = AI camera proctoring off. Set a Groq vision model name to enable it.
# GROQ_VISION_MODEL=

# ─── CORS (allowed frontend origins) ─────────────────────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOW_LAN=true        # also allow http://<private-LAN-IP>:5173 (QR codes)

# ─── Google OAuth Configuration ──────────────────────────────────────────────
# Get from https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_here
# Developer-only fake Google login when no real Client ID is set.
# Ignored when APP_ENV=production and never allowed for the admin portal.
# ALLOW_MOCK_GOOGLE_LOGIN=true

# ─── JWT Auth Settings (CHANGE IN PRODUCTION) ────────────────────────────────
# With APP_ENV=production the backend refuses to start while JWT_SECRET_KEY,
# ADMIN_PASSWORD or ADMIN_TOTP_SECRET still have their default values.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=your-random-secret-key-min-32-chars
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin Seed Credentials (CHANGE IN PRODUCTION) ───────────────────────────
# ADMIN_EMAIL=admin@skillproof.ai
# ADMIN_PASSWORD=SkillProof@Admin2024
# ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
