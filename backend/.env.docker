# Application Settings for Docker Environment
APP_NAME=SkillProof
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL container service name 'db')
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@db:5432/skillproof

# Cache Configuration (Redis container service name 'redis')
REDIS_URL=redis://redis:6379/0

# AI Services Configuration — Replace with your real key
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth Configuration — Replace with your real Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
